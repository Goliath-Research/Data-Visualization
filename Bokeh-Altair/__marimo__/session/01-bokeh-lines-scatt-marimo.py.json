      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"size-and-toolbar\">Size and toolbar</h2>\n<span class=\"paragraph\"><code>width</code> and <code>height</code> set the figure size in pixels. This figure puts the toolbar on the left.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "SFPL",
      "code_hash": "459068fe97a3c51259e256c664484522",
