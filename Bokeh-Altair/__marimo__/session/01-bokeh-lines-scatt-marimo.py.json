          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">This figure puts the toolbar above the chart. Each chart in this lesson is a new figure.</span></span>"
          }
        }
      ],
      "console": []
    },
