          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">The default legend sits at the top right. This figure moves it to the top left.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "AjVT",
      "code_hash": "c5478fc5150b39f2ec98e9b1ef01e2a1",
