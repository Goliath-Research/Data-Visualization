      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"a-gap-where-x-is-missing\">A gap where x is missing</h2>\n<span class=\"paragraph\">The third and seventh positions of <code>x</code> (indexes 2 and 6) are set to <code>NaN</code>. A line stops at a missing x and starts again at the next number.</span></span>"
          }
        }
      ],
      "console": []
