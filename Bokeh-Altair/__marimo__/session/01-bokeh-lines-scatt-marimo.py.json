        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">The legend text can change font, style, and color. This legend is bold Arial, in black, at the top center.</span></span>"
          }
        }
      ],
