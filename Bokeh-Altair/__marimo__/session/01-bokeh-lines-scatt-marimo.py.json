          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"circles-on-the-line\">Circles on the line</h2>\n<span class=\"paragraph\"><code>scatter</code> draws a circle at each point. <code>legend_label</code> names that glyph in the legend. <code>legend.location</code> places the legend.</span>\n<span class=\"paragraph\">Legend locations include <code>top_left</code>, <code>top_center</code>, <code>top_right</code>, <code>bottom_left</code>, <code>bottom_center</code>, <code>bottom_right</code>, <code>center_left</code>, <code>center</code>, and <code>center_right</code>.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "emfo",
      "code_hash": "af346bdb47da2bf78f1466d78a58fc86",
      "outputs": [],
