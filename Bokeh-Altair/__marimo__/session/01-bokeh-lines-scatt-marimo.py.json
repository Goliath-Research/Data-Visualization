          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"three-lines\">Three lines</h2>\n<span class=\"paragraph\"><code>y2</code> and <code>y3</code> are two more series on the same <code>x</code>. <code>line_dash</code> can be <code>\"dashed\"</code> or <code>\"dotted\"</code>. <code>line_color</code> sets the color. <code>legend.title</code> names the legend box.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
