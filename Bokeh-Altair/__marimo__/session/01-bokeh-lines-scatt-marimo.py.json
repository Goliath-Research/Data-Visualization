      "code_hash": "4a9a70ed49d34d4116bb1bb0333e57cb",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><code>border_line_width</code>, <code>border_line_color</code>, and <code>border_line_alpha</code> style the legend box. <code>background_fill_color</code> and <code>background_fill_alpha</code> style the fill behind the labels.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "TRpd",
      "code_hash": "4dd94fa56006813946ca5e808b475747",
