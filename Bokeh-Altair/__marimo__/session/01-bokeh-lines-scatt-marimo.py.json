          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"try-it-yourself\">Try it yourself</h3>\n<span class=\"paragraph\"><code>student_location</code> is <code>\"bottom_left\"</code>. Where does the legend sit?</span></span>"
          }
        }
      ],
      "console": []
