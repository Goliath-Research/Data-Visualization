      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><code>title.text</code> is the title string. <code>text_font_size</code>, <code>align</code>, <code>background_fill_color</code>, and <code>text_color</code> style it.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "dNNg",
      "code_hash": "884ffefd30d6a9ddd72fffba94673e93",
      "outputs": [],
