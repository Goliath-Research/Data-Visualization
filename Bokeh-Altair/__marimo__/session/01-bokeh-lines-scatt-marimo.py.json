          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"scatters\">Scatters</h2>\n<span class=\"paragraph\">Three scatters share one figure. <code>size</code> is the marker width in pixels. The legend title is <code>Circles</code>.</span></span>"
          }
        }
      ],
      "console": []
    },
