            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"a-step-line\">A step line</h2>\n<span class=\"paragraph\"><code>step</code> draws a staircase between the same points. The circles mark the data values.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
