          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><code>fill_alpha</code> is the fill transparency, from 0 (invisible) to 1 (solid). <code>line_color</code> is the marker outline.</span></span>"
